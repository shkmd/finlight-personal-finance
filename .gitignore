# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# mobile/.env holds only the public default API URL (EXPO_PUBLIC_* vars are
# bundled into the client by design, never secret) — committed so a fresh
# clone of the mobile app works without extra setup.
!mobile/.env

# local SQLite database (contains real financial data once the app is used)
prisma/*.db
prisma/*.db-journal

# local Claude Code session state
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
